{
  "name": "paraloom-wallet",
  "displayName": "Paraloom Wallet",
  "version": "1.7.2",
  "description": "Privacy-focused wallet for Paraloom Network. Create shielded wallets, manage accounts, and connect to dApps.",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && node scripts/patch-manifest.mjs",
    "package": "plasmo build && node scripts/patch-manifest.mjs && cd build/chrome-mv3-prod && zip -r -FS ../paraloom-wallet.zip . -x '*.map'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.3.1",
    "@types/bip39": "^3.0.0",
    "@types/chrome": "0.0.278",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "plasmo": "0.89.4",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  },
  "manifest": {
    "permissions": [
      "storage",
      "alarms"
    ],
    "host_permissions": [
      "https://node.paraloom.io/*",
      "https://api.devnet.solana.com/*",
      "https://lite-api.jup.ag/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
  }
}